    <!-- VFS options dialog -->
    <string name="vfs_options_title">Параметры VFS: %1$s</string>
    <string name="vfs_options_message">Указывайте пользовательские параметры VFS rclone в формате <tt>key=value</tt> (по одному на строку). Ключом является аргумент командной строки без префикса <tt>--</tt>, где все остальные дефисы заменены на символы подчёркивания. Список доступных параметров смотрите <annotation type="rclone_vfs_docs">в документации rclone.</annotation></string>
    <string name="vfs_options_reload_warning"><b>!!ВНИМАНИЕ!!</b>: для применения изменений требуется перезагрузка VFS. Это прервёт выполняемые операции с файлами в данном хранилище.</string>
