    <!-- Main preferences -->
    <string name="pref_inhibit_battery_opt_name">Отключить экономию заряда</string>
    <string name="pref_inhibit_battery_opt_desc">Необходимо для выгрузки файлов в фоновом режиме.</string>
    <string name="pref_allow_notifications_name">Разрешить уведомления</string>
    <string name="pref_allow_notifications_desc">Необходимо для отображения прогресса загрузки файлов в фоновом режиме.</string>
    <string name="pref_allow_local_network_name">Разрешить доступ к локальной сети</string>
    <string name="pref_allow_local_network_desc">Необходимо для подключения к устройствам в локальной сети.</string>
    <string name="pref_add_remote_name">Добавить хранилище</string>
    <string name="pref_add_remote_desc">Создайте новое подключение к хранилищу rclone.</string>
    <string name="pref_import_configuration_name">Импорт конфигурации</string>
    <string name="pref_import_configuration_desc">Импорт существующего файла конфигурации rclone.</string>
    <string name="pref_export_configuration_name">Экспорт конфигурации</string>
    <string name="pref_export_configuration_desc">Экспорт текущей конфигурации rclone в файл.</string>
    <string name="pref_add_file_extension_name">Добавить расширение файла</string>
    <string name="pref_add_file_extension_desc">Автоматически добавлять расширение файла при его создании.</string>
    <string name="pref_pretend_local_name">Имитировать локальное хранилище</string>
    <string name="pref_pretend_local_desc">Представлять хранилища rclone как локальные для совместимости с приложениями, которые работают только с локальными файлами.</string>
    <string name="pref_local_storage_access_name">Разрешить доступ к локальному хранилищу</string>
    <string name="pref_local_storage_access_desc">Позволяет составным хранилищам (таким как <tt>crypt</tt>) обращаться к файлам в локальной памяти по пути <tt>/sdcard</tt>.</string>
    <string name="pref_require_auth_name">Запрашивать аутентификацию</string>
    <string name="pref_require_auth_desc">Запрашивать биометрические данные или PIN-код/пароль для доступа к настройкам RSAF.</string>
    <string name="pref_inactivity_timeout_name">Время ожидания</string>
    <plurals name="pref_inactivity_timeout_desc">
        <item quantity="one">Блокировать через %d с после закрытия приложения.</item>
        <item quantity="other">Блокировать через %d с после закрытия приложения.</item>
    </plurals>
    <string name="pref_lock_now_name">Заблокировать сейчас</string>
    <string name="pref_lock_now_desc">Заблокировать немедленно, не дожидаясь автоблокировки.</string>
    <string name="pref_allow_backup_name">Резервное копирование Android</string>
    <string name="pref_allow_backup_desc">Разрешать бэкап при сквозном шифровании или прямом переносе на другое устройство. RSAF не может это проверить.</string>
    <string name="pref_version_name">Версия</string>
    <string name="pref_verbose_rclone_logs_name">Подробный журнал rclone</string>
    <string name="pref_verbose_rclone_logs_desc">Внимание: Подробный журнал может содержать конфиденциальную информацию (включая токены аутентификации).</string>
    <string name="pref_save_logs_name">Сохранить журнал</string>
    <string name="pref_save_logs_desc">Сохранение журнала logcat в файл. Учтите, что журнал может содержать имена файлов, к которым обращались на удаленном сервере.</string>
    <string name="pref_add_internal_cache_remote_name">Добавить кэширующее хранилище rclone</string>
    <string name="pref_add_internal_cache_remote_desc">Создает <tt>alias</tt> на папку кэша rclone. Полезно для отладки VFS.</string>

    <!-- Remote preferences -->
    <string name="pref_edit_remote_open_name">Открыть хранилище</string>
    <string name="pref_edit_remote_open_desc">Открыть это хранилище в системном файловом менеджере.</string>
    <string name="pref_edit_remote_configure_name">Настройка хранилища</string>
    <string name="pref_edit_remote_configure_desc">Повторно запустить мастер настройки rclone.</string>
    <string name="pref_edit_remote_rename_name">Переименование хранилища</string>
    <string name="pref_edit_remote_rename_desc">Измените имя хранилища. Все зависимые хранилища нужно будет обновить вручную.</string>
    <string name="pref_edit_remote_duplicate_name">Создать копию хранилища</string>
    <string name="pref_edit_remote_duplicate_desc">Создать копию этого хранилища с теми же настройками.</string>
    <string name="pref_edit_remote_delete_name">Удаление хранилища</string>
    <string name="pref_edit_remote_delete_desc">Удалить хранилище из конфигурации.</string>
    <string name="pref_edit_remote_allow_external_access_name">Доступ для сторонних приложений</string>
    <string name="pref_edit_remote_allow_external_access_desc">Разрешает доступ сторонним приложениям через системный файловый менеджер. Не требуется, если хранилище служит основой для другого хранилища.</string>
    <string name="pref_edit_remote_allow_locked_access_name">Доступ если RSAF заблокирован</string>
    <string name="pref_edit_remote_allow_locked_access_desc_on">Файлы остаются доступны сторонним приложениям с разрешениями, даже когда RSAF заблокировано.</string>
    <string name="pref_edit_remote_allow_locked_access_desc_off">Когда RSAF заблокировано, файлы скрыты от сторонних приложений, а новые операции с ними заблокированы. Это не влияет на уже открытые файлы.</string>
    <string name="pref_edit_remote_dynamic_shortcut_name">Ярлыки приложения</string>
    <string name="pref_edit_remote_dynamic_shortcut_desc">Показывать хранилище при долгом нажатии на значок RSAF.</string>
    <string name="pref_edit_remote_thumbnails_name">Отображение миниатюр</string>
    <string name="pref_edit_remote_thumbnails_desc">Разрешить показ миниатюр фото, видео и обложек альбомов. Это увеличить расход мобильного трафика.</string>
    <string name="pref_edit_remote_report_usage_name">Использование хранилища</string>
    <string name="pref_edit_remote_report_usage_desc_loading">(Проверка поддержки данных об использовании хранилища…)</string>
    <string name="pref_edit_remote_report_usage_desc_supported">Сообщает сторонним приложениям информацию о свободном и общем объеме хранилища. Для некоторых типов хранилищ это может значительно замедлить работу приложений при получении списка хранилищ.</string>
    <string name="pref_edit_remote_report_usage_desc_unsupported">Этот тип хранилища не поддерживает вывод данных об объеме хранилища.</string>
    <string name="pref_edit_remote_vfs_options_name">Дополнительные параметры VFS</string>
    <string name="pref_edit_remote_vfs_options_desc">Задание дополнительных опций VFS, поддерживаемых командой <tt>rclone mount</tt>.</string>

